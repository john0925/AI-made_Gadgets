<Window x:Class="MinimalMarkdownReader.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" SizeToContent="WidthAndHeight" MinWidth="360" MaxWidth="640"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="24,20,24,16">
        <StackPanel x:Name="ContentPanel" />
        <Button x:Name="CloseButton" Content="Close" IsDefault="True" IsCancel="True" Click="CloseButton_Click"
                HorizontalAlignment="Right" MinWidth="80" Padding="18,4" Margin="0,16,0,0" />
    </StackPanel>
</Window>
