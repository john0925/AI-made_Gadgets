<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\MinimalMarkdownReader.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="0.41.3" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3719.77" />
  </ItemGroup>
  <ItemGroup>
    <!-- Embedded rather than copied beside the exe, so the About text and its links cannot be edited as a loose file. -->
    <None Remove="about*.md" />
    <!-- WithCulture=false keeps about.en.md in the main assembly instead of an "en" satellite assembly. -->
    <EmbeddedResource Include="about*.md" LogicalName="MinimalMarkdownReader.%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>
</Project>
